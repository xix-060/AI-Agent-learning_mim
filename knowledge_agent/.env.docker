# ===== Docker 容器环境：容器网络地址 =====
# 由 knowledge_agent/deploy/docker-compose.yml 的 env_file 加载
# 注意：本文件会提交 git，key 保持占位；本地真实 key 放 knowledge_agent/.env（已被 gitignore）
# 冒烟测试时可临时填入真实 key，测完还原

# ===== LLM 配置（宿主机 Ollama；GPU 服务器上改为 vLLM 地址）=====
# host.docker.internal = 宿主机（compose 已配 extra_hosts 兼容 Linux）
LLM_API_KEY=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:0.5b

# ===== Embedding 配置（DashScope 云端；占位 key，部署前填真实值）=====
# embedding 无本地免费替代时必须配置，否则文档导入（向量化）会失败
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ===== Reranker 配置（DashScope；无 key 时自动降级跳过重排序）=====
RERANKER_API_KEY=your-dashscope-api-key
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANKER_MODEL=gte-rerank
