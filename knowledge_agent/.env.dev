# ===== 开发环境：DeepSeek 云端（便宜快速）=====
# 用法：本地直接跑 python knowledge_agent/api.py 时，把此文件内容复制到 knowledge_agent/.env
# 或设置环境变量加载：load_dotenv(.env.dev)

# ===== LLM 配置（DeepSeek）=====
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== Embedding 配置（DeepSeek 无 embedding API，用 DashScope）=====
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ===== Reranker 配置（DashScope）=====
RERANKER_API_KEY=your-dashscope-api-key
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANKER_MODEL=gte-rerank
