# ===== 生产环境：本地 vLLM（GPU 服务器，可控）=====
# 前置：宿主机先执行 bash scripts/start_vllm.sh 拉起 vLLM 服务（默认端口 8000）
# 注意：vLLM 不提供 embedding/reranker，这两项继续走 DashScope 云端

# ===== LLM 配置（vLLM，OpenAI 兼容端点）=====
LLM_API_KEY=EMPTY
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen2.5-7B-Instruct

# ===== Embedding 配置（DashScope）=====
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ===== Reranker 配置（DashScope）=====
RERANKER_API_KEY=your-dashscope-api-key
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANKER_MODEL=gte-rerank
